  m_text: "\u041F\u0440\u0438 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0438
    \u043A\u0430\u0440\u0435\u0442\u043E\u043A \u0438 \u043F\u043E\u0440\u0448\u043D\u044F
    \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0435
    \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043D\u0438\u0435 \u043A\u043B\u0430\u0432\u0438\u0448\u0438
