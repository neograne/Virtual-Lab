    \u0441 \u043B\u0435\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439
    \u043C\u0430\u0448\u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
    \u043D\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C \u0438\u0445
    \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0441 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E
    \u0434\u043E \u0441\u043E\u0442\u044B\u0445 \u043C\u0438\u043B\u043B\u0438\u043C\u0435\u0442\u0440\u0430."
