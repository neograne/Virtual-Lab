  m_text: "\u0414\u043B\u044F \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438
    \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u043A\u0430\u0440\u0435\u0442\u043E\u043A,
    \u043F\u043E\u0440\u0448\u043D\u044F, \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u044E\u0449\u0438\u0445
    \u0440\u0443\u0447\u0435\u043A \u0443\u0441\u0438\u043B\u0438\u0442\u0435\u043B\u044F
    \u0438 \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u0430 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0439\u0442\u0435
    \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0439 \u044D\u043B\u0435\u043C\u0435\u043D\u0442
    \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043C\u044B\u0448\u0438, \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F
    \u043A\u043D\u043E\u043F\u043A\u0443 \u0437\u0430\u0436\u0430\u0442\u043E\u0439"
